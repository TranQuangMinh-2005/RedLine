# === LLM Provider (Groq hoặc Ollama) ===
# Option 1: Groq API
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=gsk-replace-me
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.0

# Option 2: Ollama (Local / Kaggle 2x T4 GPU)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1

# === TARGET ===
TARGET_HOST=0.0.0.0
TARGET_PORT=8000
CANARY_TOKEN=CANARY-REDLINE-REPLACE-ME
SCENARIO_CUSTOMER_ID=CUS-001

# === RAG ===
RAG_COLLECTION=redline_docs
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# === DB ===
DATABASE_URL=postgresql://redline:redline@db:5432/redline

# === GUARDRAIL (bật/tắt theo từng benchmark run) ===
DEFENSE_PROFILE=none          # none | basic | strict

# === ROE LIMITS ===
ROE_MAX_REQUESTS_PER_MIN=30
ROE_MAX_TOKENS_TOTAL=500000
ROE_MAX_ATTEMPTS=5
ROE_KILL_SWITCH=false

# === LOGGING ===
LOG_LEVEL=INFO
REDACT_SECRETS=true

# === NGROK (cho Kaggle / Remote Tunnel) ===
NGROK_AUTHTOKEN=

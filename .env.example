# === LLM ===
# Endpoint "env" (Docker environment). Có thể đổi endpoint/model trên web khi đang chạy.
LLM_PROVIDER=groq
LLM_API_KEY=gsk-replace-me
LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b   # bỏ trống = mặc định trong code
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
# Endpoint dùng khi khởi động: env | groq | custom
LLM_ENDPOINT=env
# GROQ_API_KEY=                 # bỏ trống = dùng LLM_API_KEY khi LLM_BASE_URL là Groq

# Endpoint ngoài điền sẵn cho tab "Kaggle / URL" (notebooks/kaggle_ollama_gateway.ipynb)
# REMOTE_LLM_BASE_URL=https://xxxx.ngrok-free.app/v1
# REMOTE_LLM_API_KEY=<GATEWAY_TOKEN>

# Ollama chạy trên máy host (từ trong Docker):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3.5:4b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# === TARGET ===
TARGET_HOST=0.0.0.0
TARGET_PORT=8000
CANARY_TOKEN=CANARY-REDLINE-REPLACE-ME
SCENARIO_CUSTOMER_ID=CUS-001

# === RAG ===
RAG_COLLECTION=redline_docs
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# === DB ===
DATABASE_URL=postgresql://redline:redline@db:5432/redline

# === GUARDRAIL (bật/tắt theo từng benchmark run) ===
DEFENSE_PROFILE=none          # none | basic | strict

# === LLAMA GUARD (chốt riêng, độc lập profile; bật/tắt được trên web) ===
# Chạy local: make llama-guard-up  (llama.cpp server CPU + GGUF Llama-Guard-3-1B Q4_K_M ~1 GB)
LLAMA_GUARD_ENABLED=false
# Ngoài Docker: http://localhost:8088/v1 ; trong compose đã override thành http://llama-guard:8080/v1
# Dùng Ollama thay thế: LLAMA_GUARD_BASE_URL=http://localhost:11434/v1, LLAMA_GUARD_MODEL=llama-guard3:1b
LLAMA_GUARD_BASE_URL=http://localhost:8088/v1
LLAMA_GUARD_MODEL=Llama-Guard-3-1B-Q4_K_M
# Chỉ cần khi endpoint guard có xác thực (vd Kaggle gateway: GATEWAY_TOKEN)
LLAMA_GUARD_API_KEY=
LLAMA_GUARD_CHECK_OUTPUT=true
LLAMA_GUARD_FAIL_MODE=closed   # closed: guard lỗi thì chặn | open: cho qua
LLAMA_GUARD_TIMEOUT_SECONDS=30

# === PROMPT GUARD 2 (chốt riêng: prompt injection / jailbreak; bật/tắt được trên web) ===
# Chạy local: make prompt-guard-up  (container CPU + Llama-Prompt-Guard-2-86M)
# Model gated: xin quyền https://huggingface.co/meta-llama/Llama-Prompt-Guard-2-86M
# rồi tạo token Read tại https://huggingface.co/settings/tokens (chỉ cần cho lần tải đầu)
HF_TOKEN=hf_replace-me
PROMPT_GUARD_ENABLED=false
# Ngoài Docker: http://localhost:8089 ; trong compose đã override thành http://prompt-guard:8000
PROMPT_GUARD_URL=http://localhost:8089
PROMPT_GUARD_MODEL=Llama-Prompt-Guard-2-86M   # nhãn hiển thị + target_config_hash
PROMPT_GUARD_THRESHOLD=0.5     # chặn khi điểm injection >= ngưỡng (0.01–0.99)
PROMPT_GUARD_CHECK_RAG=true    # chấm cả tài liệu RAG trả cho agent (indirect injection)
PROMPT_GUARD_FAIL_MODE=closed  # closed: guard lỗi thì chặn | open: cho qua
PROMPT_GUARD_TIMEOUT_SECONDS=15

# === TRACE: UI xem prompt đi tới đâu, bị chốt nào chặn (chỉ khi request include_trace) ===
GUARDRAIL_TRACE_ENABLED=true

# === ROE LIMITS ===
ROE_MAX_REQUESTS_PER_MIN=30
ROE_MAX_TOKENS_TOTAL=500000
ROE_MAX_ATTEMPTS=5
ROE_KILL_SWITCH=false

# === LOGGING ===
LOG_LEVEL=INFO
REDACT_SECRETS=true

# === NGROK (cho Kaggle / Remote Tunnel) ===
NGROK_AUTHTOKEN=

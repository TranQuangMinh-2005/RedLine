# === LLM ===
# Endpoint "env" (Docker environment). Có thể đổi endpoint/model trên web khi đang chạy.
LLM_PROVIDER=groq
LLM_API_KEY=gsk-replace-me
LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b   # bỏ trống = mặc định trong code
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
# Endpoint dùng khi khởi động: env | groq | custom
LLM_ENDPOINT=env
# GROQ_API_KEY=                 # bỏ trống = dùng LLM_API_KEY khi LLM_BASE_URL là Groq

# Endpoint ngoài điền sẵn cho tab "Kaggle / URL" (notebooks/kaggle_ollama_gateway.ipynb)
# REMOTE_LLM_BASE_URL=https://xxxx.ngrok-free.app/v1
# REMOTE_LLM_API_KEY=<GATEWAY_TOKEN>

# Ollama chạy trên máy host (từ trong Docker):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3.5:4b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# === TARGET ===
TARGET_HOST=0.0.0.0
TARGET_PORT=8000
CANARY_TOKEN=CANARY-REDLINE-REPLACE-ME
SCENARIO_CUSTOMER_ID=CUS-001

# === RAG ===
RAG_COLLECTION=redline_docs
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# === DB ===
DATABASE_URL=postgresql://redline:redline@db:5432/redline

# === GUARDRAIL (bật/tắt theo từng benchmark run) ===
DEFENSE_PROFILE=none          # none | basic | strict

# === ROE LIMITS ===
ROE_MAX_REQUESTS_PER_MIN=30
ROE_MAX_TOKENS_TOTAL=500000
ROE_MAX_ATTEMPTS=5
ROE_KILL_SWITCH=false

# === LOGGING ===
LOG_LEVEL=INFO
REDACT_SECRETS=true

# === NGROK (cho Kaggle / Remote Tunnel) ===
NGROK_AUTHTOKEN=

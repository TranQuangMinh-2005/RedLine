# Secrets
.env
.env.*.bak
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runs output (giữ .gitkeep, bỏ nội dung run)
runs/*
!runs/.gitkeep

# Data: track approved RAG source documents, ignore generated/runtime artifacts.
data/*
!data/.gitkeep
!data/rag/
data/rag/*
!data/rag/documents/
!data/rag/documents/*.md
data/rag/manifest.jsonl
data/rag/index.json
data/rag/documents/manifest.jsonl
data/rag/documents/index.json
data/*.db

# Corpus nguồn (landing/raw + standardized) — track để tái lập được
!data/shopee-rag/
!data/shopee-rag/**
# Artifact ingest của shopee-rag cũng bị ignore (tái tạo được từ source)
data/shopee-rag/**/index.json
data/shopee-rag/**/manifest.jsonl

# OS
.DS_Store

# ===== Frontend (Next.js) =====
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ===== Artifact tạm của agent/test =====
.preview/
.dsh-vision-router/
.backup-w1/
.tmp/
.pytest-tmp-*/

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redline.local/schemas/attack-seed-v1.json",
  "title": "RedLine attack seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attack_id", "parent_attack_id", "attempt_idx", "title",
    "objective", "category", "technique", "attack_type", "prompt", "turns",
    "setup", "target_asset", "expected_success_signal", "oracle",
    "expected_safe_behavior", "owasp_ids", "atlas_ids", "language", "severity",
    "source_refs", "evidence_refs", "cleanup", "status"
  ],

  "properties": {
    "schema_version": {"const": "1.0"},
    "attack_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z]+-[0-9]{3}$"},
    "parent_attack_id": {"type": ["string", "null"]},
    "attempt_idx": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 5},
    "objective": {"type": "string", "minLength": 10},
    "category": {"type": "string"},
    "technique": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "attack_type": {"enum": ["single_turn", "multi_turn", "indirect", "indirect_multi_turn"]},
    "prompt": {"type": "string"},
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },

    "setup": {"type": ["object", "null"]},
    "target_asset": {"type": "string", "minLength": 2},
    "expected_success_signal": {"type": "string", "minLength": 10},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_sources", "success_when"],
      "properties": {
        "evidence_sources": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["response", "audit_log", "database", "retrieval_log", "guardrail_action", "latency", "frontend_sink", "spreadsheet_sink", "downstream_parser"]}
        },
        "success_when": {"type": "string", "minLength": 10}
      }
    },

    "expected_safe_behavior": {"type": "string", "minLength": 10},
    "owasp_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["LLM01", "LLM02", "LLM05", "LLM06", "LLM07", "LLM08", "LLM09", "LLM10"]}
    },
    "atlas_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "language": {"enum": ["vi", "en", "mixed", "encoded"]},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "cleanup": {"type": "string"},
    "status": {"enum": ["draft", "reviewed", "tested"]},
    "transport": {"enum": ["native_chat", "openai_messages"]},
    "difficulty": {"enum": ["L1", "L2", "L3", "L4"]},
    "attack_chain": {"type": "array", "items": {"type": "string"}},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "negative_control_id": {"type": ["string", "null"]},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 20},
    "design_notes": {"type": "string", "minLength": 10},
    "safety_domain": {"enum": ["abusive_language", "political_content"]},
    "negative_control_prompt": {"type": "string", "minLength": 5},
    "context_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "target_context_fraction", "payload_position"],
      "properties": {
        "fixture_id": {"type": "string"},
        "target_context_fraction": {"type": "number", "minimum": 0.1, "maximum": 0.8},
        "payload_position": {"enum": ["beginning", "middle", "end"]}
      }
    }
  }
}
